{
  "regions": [
    "sin1"
  ],
  "redirects": [
    {
      "source": "/search",
      "destination": "/"
    },
    {
      "source": "/library",
      "destination": "/"
    },
    {
      "source": "/downloads",
      "destination": "/"
    },
    {
      "source": "/settings",
      "destination": "/"
    },
    {
      "source": "/history",
      "destination": "/"
    },
    {
      "source": "/browse",
      "destination": "/"
    },
    {
      "source": "/settings/:path*",
      "destination": "/"
    },
    {
      "source": "/my/:id",
      "destination": "/"
    }
  ],
  "rewrites": [
    {
      "source": "/nexa/:path*",
      "destination": "/api/proxy?upstream=nexa&path=:path*"
    },
    {
      "source": "/netease/:path*",
      "destination": "/api/proxy?upstream=netease&path=:path*"
    },
    {
      "source": "/lyricsplus/:path*",
      "destination": "/api/proxy?upstream=lyricsplus&path=:path*"
    },
    {
      "source": "/boidu/:path*",
      "destination": "/api/proxy?upstream=boidu&path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
