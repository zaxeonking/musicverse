{
  "functions": {
    "api/p.mjs": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/p/:code", "destination": "/api/p?code=:code" },
    { "source": "/t/:code", "destination": "/api/t?code=:code" },
    { "source": "/((?!api/|\\.well-known/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
