# Repo GitHub tempat APK dirilis (USER/REPO). Dipakai untuk tombol "Unduh APK" di situs.
# VITE_GITHUB_REPO=USER/REPO

# Email kontak di Kebijakan Privasi dan Ketentuan Layanan (opsional). Kosong = tautan ke GitHub Issues.
# VITE_CONTACT_EMAIL=halo@contoh.com

# Jeda distribusi. Bawaan false (tombol unduh tampil). true = pengumuman migrasi tanpa tombol unduh.
# VITE_DISTRIBUTION_PAUSED=true
