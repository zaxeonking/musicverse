# Repo GitHub tempat APK dirilis (USER/REPO). Dipakai untuk tombol "Unduh APK" di situs.
# VITE_GITHUB_REPO=USER/REPO

# Email kontak di Kebijakan Privasi dan Ketentuan Layanan (opsional). Kosong = tautan ke GitHub Issues.
# VITE_CONTACT_EMAIL=halo@contoh.com

# Jeda distribusi. Bawaan false (tombol unduh tampil). true = pengumuman migrasi tanpa tombol unduh.
# VITE_DISTRIBUTION_PAUSED=true

# Halaman tautan bagikan /p/<kode> (fungsi server api/p.mjs; JANGAN diawali VITE_). Isi di Vercel > Settings > Environment Variables.
# Kunci PUBLIK saja (sb_publishable_...), JANGAN sb_secret_ / service_role.
# SUPABASE_SHARE_URL=https://xxxx.supabase.co
# SUPABASE_SHARE_KEY=sb_publishable_xxxx

# Account (dipakai oleh halaman /account). Publishable key aman untuk client; JANGAN gunakan sb_secret_/service_role.
VITE_SUPABASE_ACCOUNT_URL=https://iybqvgdpstbumbxyobnw.supabase.co
VITE_SUPABASE_ACCOUNT_KEY=sb_publishable_lmgDRSqnr87on7Maxdig6w_aa9FbBK5


# Firebase (halaman /account, Google Sign-In + Firestore). Project: musicverse-app. Nilai web Firebase bersifat publik.
