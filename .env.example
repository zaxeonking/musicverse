# Base URL API playlist (default: https://api.nexadev.my.id)
# VITE_API_BASE_URL=https://api.nexadev.my.id

# Saat development, jika terkena error CORS, pakai proxy bawaan Vite:
# VITE_API_BASE_URL=/nexa

# API download berbasis tautan lagu (default: https://app.kyzznekoo.my.id).
# Jika VITE_API_BASE_URL=/nexa, otomatis memakai proxy /kyzz.
# VITE_DOWNLOAD_API_BASE_URL=https://app.kyzznekoo.my.id

# Repo GitHub tempat APK dirilis (format USER/REPO). Dipakai untuk:
# - tombol "Unduh APK" di halaman web -> mengarah ke
#   https://github.com/USER/REPO/releases/latest, jadi link tidak perlu diganti tiap versi baru;
# - pemeriksaan pembaruan di dalam APK (banner update opsional + unduh + pasang).
# VITE_GITHUB_REPO=USER/REPO

# Email kontak yang tampil di Kebijakan Privasi dan Ketentuan Layanan (opsional).
# Kosong = tautan ke halaman Issues di repo rilis.
# VITE_CONTACT_EMAIL=halo@contoh.com

# Jeda distribusi sementara (migrasi ke aplikasi native). Bawaan: true = situs menampilkan pengumuman, tanpa tombol unduh APK.
# Isi false untuk menampilkan tombol Unduh APK lagi.
# VITE_DISTRIBUTION_PAUSED=false
