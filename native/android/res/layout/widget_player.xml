<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="Sampul"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MusicVerse"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ketuk untuk membuka"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <!-- Tampil hanya saat memuat lagu (mengambil tautan baru / buffering). -->
        <ProgressBar
            android:id="@+id/widget_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:indeterminate="true"
            android:indeterminateTint="#1DB954"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Sebelumnya"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_media_previous" />

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/widget_play_bg"
        android:contentDescription="Putar atau jeda"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Berikutnya"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_media_next" />
</LinearLayout>
